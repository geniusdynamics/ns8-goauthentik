import sys
import json
import agent

request = json.load(sys.stdin)

original_environment = request['environment']

for evar in [
        "TRAEFIK_HOST",
        "TRAEFIK_HTTP2HTTPS",
        "TRAEFIK_LETS_ENCRYPT",
    ]:
    agent.set_env(evar, original_environment[evar])

directory_defaults = {
    "AUTHENTIK_NS8_LDAP_DOMAIN": "",
    "AUTHENTIK_NS8_LDAP_MATCHING": "identifier",
    "AUTHENTIK_NS8_LDAP_ADDITIONAL_DOMAINS": "",
    "AUTHENTIK_NS8_LDAP_MANAGED": "False",
}
agent.mset_env({
    name: original_environment.get(name, default) for name, default in directory_defaults.items()
})

agent.dump_env()
