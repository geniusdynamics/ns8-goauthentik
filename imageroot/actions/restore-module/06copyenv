import sys
import json
import agent
import authentik_directory as directory

request = json.load(sys.stdin)

original_environment = request['environment']

for evar in [
        "TRAEFIK_HOST",
        "TRAEFIK_HTTP2HTTPS",
        "TRAEFIK_LETS_ENCRYPT",
    ]:
    agent.set_env(evar, original_environment[evar])

directory_defaults = {
    directory.DOMAIN: "",
    directory.MATCHING: "identifier",
    directory.ADDITIONAL: "",
    directory.MANAGED: "False",
}
directory.save_environment({
    name: original_environment.get(name, default) for name, default in directory_defaults.items()
})

agent.dump_env()
