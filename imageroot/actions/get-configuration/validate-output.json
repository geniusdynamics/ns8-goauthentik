{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get kickstart settings",
    "$id": "http://nethserver.org/json-schema/task/input/kickstart/get-configuration",
    "description": "Get kickstart settings",
    "examples": [
        {
            "host": "kickstart.domain.org",
            "http2https": true,
            "lets_encrypt": true
        }
    ],
    "type": "object",
    "required": [
        "host",
        "http2https",
        "lets_encrypt"
    ],
    "properties": {
        "host": {
            "type": "string",
            "description": "Host name for the application, like 'kickstart.domain.org'",
            "format": "idn-hostname"
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate",
            "description": "Request a valid Let's Encrypt certificate."
        },
        "http2https": {
            "type": "boolean",
            "title": "HTTP to HTTPS redirection",
            "description": "Redirect all the HTTP requests to HTTPS"
        },
        "ldap_domain": {
            "type": "string"
        },
        "ldap_additional_domains": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "ldap_user_matching": {
            "enum": [
                "identifier",
                "username_link"
            ]
        },
        "ldap_domains": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "schema"
                ],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "schema": {
                        "enum": [
                            "ad",
                            "rfc2307"
                        ]
                    }
                }
            }
        }
    }
}
